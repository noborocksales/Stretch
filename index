      <button class="btn-submit" style="background:#334155; margin-top:10px;" onclick="closeAdmin()">閉じる</button>
    </div>
  </div>

  <div class="admin-toggle" onclick="toggleAdminView()">スタッフ専用管理画面</div>
</div>

