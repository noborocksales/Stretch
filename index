function submitRating() {
  if (!currentRating) {
    alert("星評価を選択してください。");
    return;
  }
  const comment = document.getElementById('rating-comment').value;
  const logs = JSON.parse(localStorage.getItem(LOCAL_LOGS_KEY) || "[]");
  const logIndex = logs.findIndex(l => l.id === currentLogId);
  if (logIndex !== -1) {
    logs[logIndex].rating = currentRating;
    logs[logIndex].comment = comment;
    localStorage.setItem(LOCAL_LOGS_KEY, JSON.stringify(logs));
  }
  alert("評価を送信しました。ご協力ありがとうございます！");
}

function saveLog(answers, topPick) {
  const logId = Date.now();
  try {
    const logs = JSON.parse(localStorage.getItem(LOCAL_LOGS_KEY) || "[]");
    logs.unshift({
      id: logId,
      timestamp: new Date().toISOString(),
      sneaker: answers.sneaker,
      levelText: answers.levelText,
      widthText: answers.widthText,
      instepText: answers.instepText,
      toeText: answers.toeText,
      perfText: answers.perfText,
      topPick: topPick ? topPick.name : "N/A",
      rating: null,
      comment: ""
    });
    localStorage.setItem(LOCAL_LOGS_KEY, JSON.stringify(logs));
  } catch (e) {
    console.error(e);
  }
  return logId;
}

