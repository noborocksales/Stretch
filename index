<header>
  <h1>NOBOROCK 渋谷店</h1>
  <div class="subtitle">クライミングシューズ高精度診断ツール</div>
</header>

<div id="app">
  <!-- 診断フォーム -->
  <div id="view-form" class="card">
    <div class="step-title"><span class="step-badge">STEP 1</span> 基本情報</div>
    
    <div class="form-group">
      <label>1. 普段のスニーカーのサイズ (cm)</label>
      <input type="number" id="input-sneaker" step="0.5" value="26.0">
    </div>

    <div class="form-group">
      <label>2. クライミング歴・保有靴数</label>
