function getSelectedValue(groupId) {
  const selected = document.querySelector(`#${groupId} .option-btn.selected`);
  return selected ? selected.getAttribute('data-value') : 'none';
}

function getSelectedText(groupId) {
  const selected = document.querySelector(`#${groupId} .option-btn.selected`);
  return selected ? selected.innerText : '選択なし';
}

// 標準サイズレンジ算出
function calculateStandardSizes(sneakerSize) {
  const d = sneakerSize - 26.0;
  return `スポルティバ/スカルパ: EU ${(39.0+d).toFixed(1)}〜${(40.0+d).toFixed(1)} | アンパラレル/ブトラ/マッドロック: US ${(7.5+d).toFixed(1)}〜${(8.5+d).toFixed(1)} | ボリエール/テナヤ: UK ${(6.5+d).toFixed(1)}〜${(7.5+d).toFixed(1)}`;
}

// ブランド別表記＆固有オフセット算出
function getRecommendedSizeText(shoe, sneakerSize) {
  const d = sneakerSize - 26.0;
  const offset = shoe.sizeOffset || 0.0;
  
  if (shoe.sizeUnit === 'EU') {
    const base = 39.5 + d + offset;
    return `EU ${(base - 0.5).toFixed(1)} 〜 ${(base + 0.5).toFixed(1)}`;
  } else if (shoe.sizeUnit === 'US') {
    const base = 8.0 + d + offset;
    return `US ${(base - 0.5).toFixed(1)} 〜 ${(base + 0.5).toFixed(1)}`;
  } else { // UK
    const base = 7.0 + d + offset;
    return `UK ${(base - 0.5).toFixed(1)} 〜 ${(base + 0.5).toFixed(1)}`;
  }
}

// 相性スコア計算アルゴリズム（レベル評価を3倍に重み付け）
function calculateShoeScore(shoe, u) {
  let score = 0;
  
  if (u.level === shoe.categoryLevel) {
    score += (shoe.score_level * 15) * 3;
  } else {
    score -= 150;
  }

  score += (u.width === 'none') ? 3 : (shoe[`score_width_${u.width}`] || 3);
  score += (u.instep === 'none') ? 3 : (shoe[`score_instep_${u.instep}`] || 3);
  score += (u.toe === 'none') ? 3 : (shoe[`score_toe_${u.toe}`] || 3);
  score += (u.perf === 'none') ? 3 : (shoe[`score_perf_${u.perf}`] || 3);

  return score;
}

function runDiagnosis() {
  const sneakerSize = parseFloat(document.getElementById('input-sneaker').value) || 26.0;
  const levelSelect = document.getElementById('input-level');
  
  const userAnswers = {
    sneaker: sneakerSize,
    levelVal: parseInt(levelSelect.value, 10),
    levelText: levelSelect.options[levelSelect.selectedIndex].text,
    widthText: getSelectedText('group-width'),
    instepText: getSelectedText('group-instep'),
    toeText: getSelectedText('group-toe'),
    perfText: getSelectedText('group-perf'),
    width: getSelectedValue('group-width'),
    instep: getSelectedValue('group-instep'),
    toe: getSelectedValue('group-toe'),
    perf: getSelectedValue('group-perf')
  };

  document.getElementById('standard-size-display').innerText = calculateStandardSizes(sneakerSize);

  const scoredShoes = SHOE_DATABASE.map(shoe => ({
    ...shoe,
    calculatedScore: calculateShoeScore(shoe, userAnswers),
    recommendedSize: getRecommendedSizeText(shoe, sneakerSize)
  })).sort((a, b) => b.calculatedScore - a.calculatedScore).slice(0, 5);

  const container = document.getElementById('recommendations-container');
  container.innerHTML = '';

  scoredShoes.forEach((shoe, idx) => {
    const card = document.createElement('div');
    card.className = 'shoe-card';
    card.innerHTML = `
      <div class="shoe-img-wrapper">
        <img class="shoe-img" src="${shoe.imageUrl}" alt="${shoe.name}" onerror="this.src='https://via.placeholder.com/400x300?text=NOBOROCK+Image'">
      </div>
      <div class="shoe-info">
        <div class="shoe-brand">第 ${idx + 1} 位 : ${shoe.brand}</div>
        <div class="shoe-name">${shoe.name}</div>
        <div class="rec-size">推奨サイズ (${shoe.sizeUnit}): ${shoe.recommendedSize}</div>
        <div class="shoe-desc">${shoe.description}</div>
        <a href="${shoe.noteUrl}" target="_blank" rel="noopener noreferrer" class="btn-article">NAKAYAの解説記事を読む</a>
      </div>
    `;
    container.appendChild(card);
  });

  currentLogId = saveLog(userAnswers, scoredShoes[0]);

  document.getElementById('view-form').classList.add('hidden');
  document.getElementById('view-result').classList.remove('hidden');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

