        <option value="1">1足目（ビギナー向け）</option>
        <option value="2" selected>2足目（ステップアップ）</option>
        <option value="3">3足目以上（中上級・本気靴）</option>
      </select>
    </div>

    <div class="step-title" style="margin-top:25px;"><span class="step-badge">STEP 2</span> 足型と好みの属性</div>

    <div class="form-group">
      <label>3. 幅の広さ</label>
      <div class="btn-group" id="group-width">
        <div class="option-btn" data-value="narrow">細め</div>
        <div class="option-btn" data-value="normal">普通</div>
        <div class="option-btn" data-value="wide">広め</div>
        <div class="option-btn selected" data-value="none">選択しない</div>
      </div>
    </div>

    <div class="form-group">
      <label>4. 甲の高さ</label>
      <div class="btn-group" id="group-instep">
        <div class="option-btn" data-value="low">低め</div>
        <div class="option-btn" data-value="normal">普通</div>
        <div class="option-btn" data-value="high">高め</div>
        <div class="option-btn selected" data-value="none">選択しない</div>
      </div>
    </div>

    <div class="form-group">
      <label>5. つま先の形状</label>
      <div class="btn-group" id="group-toe">
        <div class="option-btn" data-value="egyptian">親指が長い (エジプト)</div>
        <div class="option-btn" data-value="roman">人差し指が長い (ギリシャ)</div>
        <div class="option-btn" data-value="greek">指が揃っている (スクエア)</div>
        <div class="option-btn selected" data-value="none">選択しない</div>
      </div>
    </div>

    <div class="form-group">
      <label>6. 求めるソール特性</label>
      <div class="btn-group" id="group-perf">
        <div class="option-btn" data-value="soft">ソフト（足裏感覚）</div>
        <div class="option-btn" data-value="allround">オールラウンド</div>
        <div class="option-btn" data-value="hard">ハード（エッジング）</div>
        <div class="option-btn selected" data-value="none">選択しない</div>
      </div>
    </div>

    <button class="btn-submit" onclick="runDiagnosis()">診断結果を見る（上位5足）</button>
  </div>

  <!-- 診断結果画面 -->
  <div id="view-result" class="hidden">
    <div class="size-box">
      <div class="size-title">ブランド別 標準基準サイズ目安</div>
      <div class="size-val" id="standard-size-display">--</div>
    </div>

    <h2 style="font-size: 1.05rem; margin-bottom: 12px; color: var(--text-main);">あなたにおすすめのシューズ Top 5</h2>
    <div id="recommendations-container"></div>

    <!-- 診断後の評価アンケート -->
    <div class="card" style="margin-top: 25px;">
      <div class="step-title">診断結果の満足度評価</div>
      <p style="font-size: 0.85rem; color: var(--text-sub);">今回の提案結果についての評価をお聞かせください。</p>
      
      <div class="star-rating" id="rating-stars">
        <span class="star" data-star="1">★</span>
        <span class="star" data-star="2">★</span>
        <span class="star" data-star="3">★</span>
        <span class="star" data-star="4">★</span>
        <span class="star" data-star="5">★</span>
      </div>

      <div class="form-group">
        <textarea id="rating-comment" rows="3" placeholder="ご意見・フィードバック（任意）"></textarea>
      </div>
      
      <button class="btn-submit" onclick="submitRating()">評価を送信する</button>
    </div>

    <button class="btn-submit" style="background:#334155; margin-bottom:20px;" onclick="resetForm()">もう一度診断する</button>
  </div>

  <!-- 管理者画面 -->
